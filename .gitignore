# 依赖
node_modules/
web/node_modules/
.venv/

# 构建产物
web/dist/
web/dist.bak/
web/vite.config.ts.timestamp-*

# 本地数据（历史会话库，含个人面试记录，不要提交）
# 注意必须有前导斜杠：写成 data/ 会把 web/src/data/ 也一起忽略掉，
# 导致源码文件（如 tracks.ts）永远提交不上，别人 clone 下来直接构建失败。
/data/

# 本地 AI 工作日志 / 工作区元数据
.workbuddy/

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
npm-debug.log*
__pycache__/
*.pyc

# 临时验证目录（测试仓库克隆、接口响应快照等）
/.tmp/

# 本地环境变量（真实 webhook key、模型 API Key 等一律不进仓库）
# notifier.yaml 里的 webhook 故意留空，真实值放这里或系统环境变量
.env
.env.local
.env.*.local
